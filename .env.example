# Client-Side Public Environment Variables (Vite / Browser exposed)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Server-Side / Edge Function Environment Variables
# (NEVER expose these with VITE_ prefix or in frontend bundles!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Application Host URL (e.g. https://fitzone.vercel.app or http://localhost:5173)
APP_URL=http://localhost:5173
